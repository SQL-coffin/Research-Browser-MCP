{
  "name": "research-browser-mcp",
  "version": "0.1.0",
  "description": "Auditable, read-only research browsing service exposed over MCP",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "bin": {
    "research-browser-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:smoke": "node --import tsx --test tests/smoke/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
